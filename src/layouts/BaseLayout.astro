---
import BaseHead, { type Props as HeadProps } from '~/components/BaseHead.astro';
import ConsentBanner from '~/components/ConsentBanner.astro';
import Footer from '~/components/Footer.astro';
import Header from '~/components/Header.astro';
import StickyAd from '~/components/StickyAd.astro';
import { site } from '~/config/site';
import { adsClientConfig, consentNeeded } from '~/lib/ads';

type Props = HeadProps & {
  /** Trust and policy pages carry no ads (and load no ad code). */
  noAds?: boolean;
};
const { noAds = false, ...head } = Astro.props;
const ads = noAds ? undefined : adsClientConfig();
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <BaseHead {...head} />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col" data-ads={ads}>
    <a
      href="#main"
      class="sr-only-focusable fixed top-2 left-2 z-[100] rounded-lg bg-accent px-4 py-3 font-semibold text-on-accent"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer />
    {ads && site.ads.units['sticky-mobile'] && <StickyAd />}
    {consentNeeded() && <ConsentBanner />}
    <script>
      import { initAds } from '~/scripts/ads';
      import { initConsent } from '~/scripts/consent';
      initConsent();
      initAds();
    </script>
  </body>
</html>
