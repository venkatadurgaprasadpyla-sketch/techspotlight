---
/** Author avatar, name and role, then publish and update dates. Used by the article templates. */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { authorPath } from '~/lib/archives';
import { formatDate, formatDateTime, hasTime, isoDate } from '~/lib/format';

interface Props {
  author: CollectionEntry<'authors'> | undefined;
  publishDate: Date;
  updatedDate?: Date | undefined;
  /** Shown after the dates, e.g. "Checked on Windows 11". */
  note?: string | undefined;
  /** News: show the time of day (IST) too, when the date has one. */
  withTime?: boolean;
}
const { author, publishDate, updatedDate, note, withTime = false } = Astro.props;
const show = (date: Date) => (withTime ? formatDateTime(date) : formatDate(date));
const machine = (date: Date) => (withTime && hasTime(date) ? date.toISOString() : isoDate(date));
---

<div class="flex items-center gap-3 text-[14px]" data-pagefind-ignore>
  {author?.data.avatar && (
    <Image
      src={author.data.avatar}
      alt=""
      width={40}
      height={40}
      class="size-10 flex-none rounded-full object-cover"
    />
  )}
  <p>
    {author && (
      <>
        <a href={authorPath(author.id)} class="font-semibold text-text">
          {author.data.name}
        </a>
        <span class="hidden text-muted sm:inline">, {author.data.role}</span>
        <span class="text-muted" aria-hidden="true">
          {' '}
          ·{' '}
        </span>
      </>
    )}
    <span class="text-muted">
      Published <time datetime={machine(publishDate)}>{show(publishDate)}</time>
      {updatedDate && (
        <>
          <span aria-hidden="true"> · </span>Updated{' '}
          <time datetime={machine(updatedDate)}>{show(updatedDate)}</time>
        </>
      )}
      {note && (
        <>
          <span aria-hidden="true"> · </span>
          {note}
        </>
      )}
    </span>
  </p>
</div>
