---
import type { CardItem } from '~/lib/cards';
import { formatDate, formatMonthYear, isoDate } from '~/lib/format';

/**
 * "Author · 9 Oct 2026" ("Author · Updated 1 Oct 2026" once revised), or "Updated October 2026"
 * for buying guides. Always the date listings sort on.
 */
interface Props {
  item: CardItem;
  class?: string;
}
const { item, class: className } = Astro.props;
const isGuide = item.collection === 'guides';
---

<p class:list={['text-[13px] text-muted', className]}>
  {isGuide ? (
    <>
      Updated <time datetime={isoDate(item.date)}>{formatMonthYear(item.date)}</time>
    </>
  ) : (
    <>
      {item.authorName && <>{item.authorName} · </>}
      {item.updatedDate && 'Updated '}
      <time datetime={isoDate(item.date)}>{formatDate(item.date)}</time>
    </>
  )}
</p>
