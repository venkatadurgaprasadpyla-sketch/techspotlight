---
/**
 * Retailer prices with affiliate links. `compact` sits inside the verdict box; the full widget
 * closes the review. Amazon and offers without a price say "Check latest price". India and UAE
 * visitors each see their own stores (offerRegions).
 */
import {
  AFFILIATE_REL,
  affiliateHref,
  getRetailer,
  offerRegions,
  priceButtonLabel,
  showsPrice,
} from '~/lib/affiliate';
import { formatDate, formatPrice, isoDate } from '~/lib/format';

export interface RetailerOffer {
  name: string;
  url: string;
  price?: number | undefined;
  lastChecked: Date;
}
interface Props {
  offers: RetailerOffer[];
  productName: string;
  compact?: boolean;
}
const { offers, productName, compact = false } = Astro.props;
const shownPrice = (o: RetailerOffer) => (o.price && showsPrice(o.name) ? o.price : undefined);
const priceOf = (o: RetailerOffer) => shownPrice(o) ?? Number.POSITIVE_INFINITY;
const regions = offerRegions(offers);
const sorted = offers
  .map((offer, i) => ({ offer, region: regions[i] }))
  .sort((a, b) => priceOf(a.offer) - priceOf(b.offer));
// The oldest check, so a stale price is never presented as freshly checked.
const priced = offers.filter((o) => shownPrice(o) !== undefined);
const checked =
  priced.length > 0 ? new Date(Math.min(...priced.map((o) => o.lastChecked.getTime()))) : undefined;
---

<div class:list={[!compact && 'flex flex-col gap-3']}>
  <ul class:list={['divide-y divide-border', !compact && 'rounded-[10px] border border-border']}>
    {sorted.map(({ offer, region }) => {
      const retailer = getRetailer(offer.name);
      const store = retailer?.name ?? offer.name;
      const price = shownPrice(offer);
      return (
        <li
          class="flex flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6"
          data-region-only={region === 'all' ? undefined : region}
        >
          <b>{store}</b>
          <span class="flex flex-wrap items-center gap-3">
            {price ? (
              <b class="font-mono text-[17px] font-medium">
                {formatPrice(price, retailer?.currency ?? 'INR')}
              </b>
            ) : (
              <span class="text-[13px] text-muted">Check latest price</span>
            )}
            <a
              class="btn btn-buy"
              href={affiliateHref(offer.name, offer.url)}
              rel={AFFILIATE_REL}
              target="_blank"
            >
              {priceButtonLabel(offer.name)}
              <span class="sr-only">
                : {productName} at {store}, opens in a new tab
              </span>
            </a>
          </span>
        </li>
      );
    })}
  </ul>
  <p class:list={['text-[13px] text-muted', compact && 'px-4 pb-4 sm:px-6']}>
    {checked && (
      <>
        Prices checked <time datetime={isoDate(checked)}>{formatDate(checked)}</time>.{' '}
      </>
    )}
    We may earn a commission when you buy through these links.{' '}
    <a href="/affiliate-disclosure/">How this works</a>
  </p>
</div>
