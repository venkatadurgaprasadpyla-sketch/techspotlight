---
/**
 * Specs that scroll sideways on small screens with the label column pinned. The launch price
 * row shows rupees in India and, when known, dirhams to UAE visitors.
 */
import type { Region } from '~/config/site';
import { formatAed, formatInr } from '~/lib/format';

interface Props {
  specs: { label: string; value: string }[];
  msrp?: number | undefined;
  msrpAed?: number | undefined;
}
const { specs, msrp, msrpAed } = Astro.props;
type Row = { label: string; value: string; region?: Region | undefined };
const priceRows: Row[] = [
  ...(msrp
    ? [
        {
          label: 'Launch price',
          value: formatInr(msrp),
          region: msrpAed ? ('in' as const) : undefined,
        },
      ]
    : []),
  ...(msrpAed ? [{ label: 'UAE price', value: formatAed(msrpAed), region: 'ae' as const }] : []),
];
const rows: Row[] = [...priceRows, ...specs];
---

<section id="specs" class="flex scroll-mt-20 flex-col gap-3.5" aria-labelledby="specs-title">
  <h2 id="specs-title" class="text-[28px]">
    Specs
  </h2>
  <div
    class="overflow-x-auto rounded-[10px] border border-border"
    tabindex="0"
    role="region"
    aria-label="Specs table (scrolls sideways)"
  >
    <table class="w-full min-w-[480px] border-collapse text-left">
      <tbody>
        {rows.map((row) => (
          <tr class="border-b border-border last:border-0" data-region-only={row.region}>
            <th
              scope="row"
              class="sticky left-0 w-[38%] bg-surface px-4 py-3 align-top font-semibold"
            >
              {row.label}
            </th>
            <td class="px-4 py-3 font-mono text-[14px]">{row.value}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
