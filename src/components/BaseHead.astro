---
import { Font } from 'astro:assets';
import { site } from '~/config/site';
import { OG_HEIGHT, OG_WIDTH } from '~/lib/seo';
import { absolute, type JsonLd } from '~/lib/structured-data';
import '~/styles/global.css';

export interface Props {
  /** Page title without the site name; omit on the homepage. */
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Share image: an absolute 1200×630 URL from `ogImage()`; defaults to the site card. */
  image?: string | undefined;
  imageAlt?: string | undefined;
  /** Articles also get published and modified times. */
  article?: { published: Date; modified?: Date | undefined } | undefined;
  /** Structured data for this page (src/lib/structured-data.ts). */
  jsonLd?: JsonLd[];
  /** A section feed to advertise next to the site feed, e.g. a hub's /<hub>/rss.xml. */
  feed?: { title: string; href: string } | undefined;
}

const {
  title,
  description = site.description,
  noindex = false,
  image,
  imageAlt,
  article,
  jsonLd = [],
  feed,
} = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name}: ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = image ?? absolute('/og-default.png');
const shareAlt = image ? (imageAlt ?? '') : `${site.name}: ${site.tagline}`;
const ogLocale = site.locale.replace('-', '_');
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:title" content={title ?? fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={shareImage} />
<meta property="og:image:width" content={String(OG_WIDTH)} />
<meta property="og:image:height" content={String(OG_HEIGHT)} />
<meta property="og:image:alt" content={shareAlt} />
{article && (
  <>
    <meta property="article:published_time" content={article.published.toISOString()} />
    <meta
      property="article:modified_time"
      content={(article.modified ?? article.published).toISOString()}
    />
  </>
)}
<meta name="twitter:card" content="summary_large_image" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${site.name}: latest`}
  href={absolute('/rss.xml')}
/>
{feed && (
  <link rel="alternate" type="application/rss+xml" title={feed.title} href={absolute(feed.href)} />
)}
{jsonLd.map((data) => (
  <script type="application/ld+json" set:html={JSON.stringify(data).replaceAll('<', '\\u003c')} />
))}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="color-scheme" content="light dark" />
{/* Filled from the resolved page background by src/scripts/theme.ts. */}
<meta name="theme-color" content="" />
{/* Resolve the theme before first paint so there is no flash; see src/scripts/theme.ts. */}
<script is:inline>
  (function () {
    let t = null;
    try {
      t = localStorage.getItem('ts-theme');
    } catch {
      // Storage blocked: fall back to the OS preference.
    }
    if (t !== 'light' && t !== 'dark') {
      t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }
    document.documentElement.dataset.theme = t;
  })();
</script>
{/* Controls that only work with JS (deal filters, copy buttons) are in the HTML from the start,
  so nothing shifts when scripts load. Without JS they are hidden. */}
<noscript>
  <style is:inline>
    [data-needs-js] {
      display: none !important;
    }
  </style>
</noscript>
<Font cssVariable="--font-plex-sans" preload={[{ weight: '400', style: 'normal' }]} />
<Font cssVariable="--font-space-grotesk" preload={[{ weight: '700' }]} />
<Font cssVariable="--font-plex-mono" />
