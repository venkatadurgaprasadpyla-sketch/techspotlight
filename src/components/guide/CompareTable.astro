---
/** "Compare the picks": one row per pick; spec columns are the labels the picks share most. */
import { formatInr } from '~/lib/format';

interface Row {
  rank: number;
  productName: string;
  rating: number;
  price?: number | undefined;
  specs: { label: string; value: string }[];
}
interface Props {
  picks: Row[];
  maxSpecs?: number;
}
const { picks, maxSpecs = 4 } = Astro.props;
const counts = new Map<string, number>();
for (const pick of picks) {
  for (const spec of pick.specs) counts.set(spec.label, (counts.get(spec.label) ?? 0) + 1);
}
const columns = [...counts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, maxSpecs)
  .map(([label]) => label);
const valueOf = (pick: Row, label: string) =>
  pick.specs.find((s) => s.label === label)?.value ?? '–';
---

<section id="compare" class="flex scroll-mt-20 flex-col gap-3.5" aria-labelledby="compare-title">
  <h2 id="compare-title" class="text-[28px]">
    Compare the picks
  </h2>
  <div
    class="overflow-x-auto rounded-[10px] border border-border"
    tabindex="0"
    role="region"
    aria-label="Compare the picks (scrolls sideways)"
  >
    <table class="w-full min-w-[560px] border-collapse text-left text-[14px]">
      <thead class="bg-surface">
        <tr>
          <th scope="col" class="sticky left-0 bg-surface px-4 py-3">
            Pick
          </th>
          <th scope="col" class="px-4 py-3">
            Rating
          </th>
          {columns.map((label) => (
            <th scope="col" class="px-4 py-3">
              {label}
            </th>
          ))}
          <th scope="col" class="px-4 py-3">
            Price
          </th>
        </tr>
      </thead>
      <tbody>
        {picks.map((pick) => (
          <tr class="border-t border-border">
            <th scope="row" class="sticky left-0 bg-bg px-4 py-3 font-semibold">
              <a href={`#pick-${pick.rank}`} class="text-text">
                {pick.productName}
              </a>
            </th>
            <td class="px-4 py-3 whitespace-nowrap">
              {pick.rating}
              <span class="text-muted">/5</span>
            </td>
            {columns.map((label) => (
              <td class="px-4 py-3 font-mono text-[13px]">{valueOf(pick, label)}</td>
            ))}
            <td class="px-4 py-3 font-mono text-[13px] whitespace-nowrap">
              {pick.price ? formatInr(pick.price) : '–'}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
