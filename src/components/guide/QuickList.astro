---
/** "The quick list": every pick at a glance, each linking to its entry further down. */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Rating from '~/components/cards/Rating.astro';
import { formatInr } from '~/lib/format';

export interface QuickPick {
  rank: number;
  label: string;
  productName: string;
  image: ImageMetadata;
  rating: number;
  price?: { amount: number; store?: string | undefined } | undefined;
}
interface Props {
  picks: QuickPick[];
}
const { picks } = Astro.props;
---

<section
  id="quick-list"
  class="flex scroll-mt-20 flex-col gap-3.5"
  aria-labelledby="quick-list-title"
>
  <div class="sec-head">
    <h2 id="quick-list-title" class="text-[26px]">
      The quick list
    </h2>
    <span class="text-[13px] text-muted">Jump to a pick</span>
  </div>
  <ol class="flex flex-col divide-y divide-border">
    {picks.map((pick) => (
      <li class="relative flex items-center gap-4 py-3">
        <span
          class="w-7 flex-none font-heading text-[26px] leading-none font-bold text-muted"
          aria-hidden="true"
        >
          {pick.rank}
        </span>
        <Image
          src={pick.image}
          alt=""
          widths={[96, 192]}
          sizes="96px"
          class="aspect-[4/3] w-[72px] flex-none rounded-md object-cover sm:w-24"
        />
        <div class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-4 gap-y-1">
          <span class="lbl w-full" aria-hidden="true">
            {pick.label}
          </span>
          <a
            href={`#pick-${pick.rank}`}
            class="font-semibold text-text no-underline after:absolute after:inset-0 hover:text-text hover:underline"
          >
            <span class="sr-only">
              {pick.rank}. {pick.label}:{' '}
            </span>
            {pick.productName}
          </a>
          <Rating value={pick.rating} showNumber={false} class="text-[13px]" />
          {pick.price && (
            <span class="font-mono text-[13px] text-muted">
              {formatInr(pick.price.amount)}
              {pick.price.store && <> at {pick.price.store}</>}
            </span>
          )}
        </div>
      </li>
    ))}
  </ol>
</section>
