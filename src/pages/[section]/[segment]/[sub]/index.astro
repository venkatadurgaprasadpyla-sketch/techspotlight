---
import type { GetStaticPaths } from 'astro';
import { isOutsideSections, placeholderStaticPaths } from '~/config/routes';
import Placeholder from '~/layouts/Placeholder.astro';

// Placeholder subcategory pages; real templates arrive in T3.
export const getStaticPaths = (() =>
  placeholderStaticPaths(
    ['section', 'segment', 'sub'],
    '/',
    isOutsideSections,
  )) satisfies GetStaticPaths;

const { title, intro } = Astro.props;
---

<Placeholder title={title} intro={intro} />
