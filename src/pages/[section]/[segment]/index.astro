---
import type { GetStaticPaths } from 'astro';
import { isOutsideSections, placeholderStaticPaths } from '~/config/routes';
import Placeholder from '~/layouts/Placeholder.astro';

// Placeholder category and per-hub content-type pages; real templates arrive in T3.
export const getStaticPaths = (() =>
  placeholderStaticPaths(['section', 'segment'], '/', isOutsideSections)) satisfies GetStaticPaths;

const { title, intro } = Astro.props;
---

<Placeholder title={title} intro={intro} />
