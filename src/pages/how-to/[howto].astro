---
/** How-to: /how-to/<id>/. Section order follows the HowTo board. */
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import AdSlot from '~/components/AdSlot.astro';
import ArticleByline from '~/components/ArticleByline.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import SearchData from '~/components/SearchData.astro';
import ArticleTopics from '~/components/ArticleTopics.astro';
import ArticleCard from '~/components/cards/ArticleCard.astro';
import Faq from '~/components/review/Faq.astro';
import { contentTypePath, contentTypes, findTopic } from '~/config/taxonomy';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { articleSeo } from '~/lib/seo';
import { article } from '~/lib/structured-data';
import { getArticles } from '~/lib/articles';
import { searchData } from '~/lib/search-index';
import { getPublished, getPublishedEntry } from '~/lib/content';
import { leafSlug } from '~/lib/content-schema';
import { assertNoHeadingClash } from '~/lib/headings';
import { topicCrumbs } from '~/lib/listings';
import { closestTo } from '~/lib/related';
import { articlePath } from '~/lib/urls';

interface Props {
  entry: CollectionEntry<'howtos'>;
}

export const getStaticPaths = (async () => {
  const howtos = await getPublished('howtos');
  return howtos.map((entry) => ({ params: { howto: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props as Props;
const { data } = entry;
const { Content, headings } = await render(entry);
const leaf = leafSlug(data);
const topic = findTopic(leaf);
if (!topic) throw new Error(`How-to ${entry.id}: unknown topic ${leaf}`);
const url = articlePath('howtos', entry.id, leaf);
const search = await searchData(url);
const crumbs = [...topicCrumbs(topic), { label: data.title, href: url }];
assertNoHeadingClash(`How-to ${entry.id}`, headings, [
  'quick-answer',
  'what-you-need',
  'steps',
  ...data.steps.map((_, i) => `step-${i + 1}`),
  'troubleshooting',
  'related-howtos',
  'steps-nav',
]);

const author = await getPublishedEntry('authors', data.author.id);
const seo = await articleSeo(data, url, author);
const articles = await getArticles();
const here = { url, hub: data.hub, category: data.category };
const related = closestTo(
  here,
  articles.filter((a) => a.collection === 'howtos'),
  4,
);
// A buying guide on the same topic, as the "time for a new one?" box.
const [guide] = closestTo(
  here,
  articles.filter((a) => a.collection === 'guides' && a.hub === data.hub),
  1,
);
const howtoType = contentTypes.find((t) => t.type === 'how-to');
const difficulty = { easy: 'Easy', medium: 'Medium', hard: 'Hard' }[data.difficulty];
const glance = [
  { label: 'Difficulty', value: difficulty },
  { label: 'Time', value: data.timeRequired },
  ...(data.worksOn ? [{ label: 'Works on', value: data.worksOn }] : []),
  { label: 'Steps', value: String(data.steps.length) },
];
// One in-article ad after the second step, when there are enough steps around it.
const adAfter = data.steps.length > 3 ? 2 : -1;
---

<BaseLayout
  title={data.title}
  description={data.description}
  noindex={data.noindex}
  {...seo.head}
  jsonLd={[article(seo.input)]}
>
  <article
    data-pagefind-body={search && ''}
    class="wrap flex flex-col gap-12 pt-5 pb-12 lg:grid lg:grid-cols-[minmax(0,1fr)_300px]"
  >
    <SearchData data={search} />
    <div class="flex max-w-[780px] min-w-0 flex-col gap-8">
      <header class="flex flex-col gap-3.5">
        <Breadcrumbs crumbs={crumbs} />
        <span class="lbl">How-to</span>
        <h1 class="text-[30px] sm:text-[40px]">{data.title}</h1>
        <p class="text-lg text-muted">{data.description}</p>
        <ArticleByline
          author={author}
          publishDate={data.publishDate}
          updatedDate={data.updatedDate}
        />
      </header>

      <dl class="grid grid-cols-[repeat(auto-fit,minmax(140px,1fr))] gap-3">
        {glance.map((item) => (
          <div class="flex flex-col gap-0.5 rounded-[10px] border border-border px-4 py-3">
            <dt class="text-[13px] text-muted">{item.label}</dt>
            <dd class="font-semibold">{item.value}</dd>
          </div>
        ))}
      </dl>

      {data.quickAnswer && (
        <section class="flex flex-col gap-2" aria-labelledby="quick-answer">
          <h2 id="quick-answer" class="lbl font-sans">
            Quick answer
          </h2>
          <p class="text-lg">{data.quickAnswer}</p>
        </section>
      )}

      <div class="prose max-w-none text-[17px] sm:text-lg [&_h2]:scroll-mt-20">
        <Content />
      </div>
      <ArticleTopics url={url} />

      {data.tools.length > 0 && (
        <section
          class="flex flex-col gap-3 rounded-[10px] bg-surface p-5"
          aria-labelledby="what-you-need"
        >
          <h2 id="what-you-need" class="text-xl">
            What you need
          </h2>
          <ul class="flex list-disc flex-col gap-1.5 pl-5">
            {data.tools.map((tool) => (
              <li>{tool}</li>
            ))}
          </ul>
        </section>
      )}

      <section aria-labelledby="steps" class="flex flex-col gap-6">
        <h2 id="steps" class="sr-only">
          Steps
        </h2>
        <ol class="flex flex-col gap-6">
          {data.steps.map((step, i) => (
            <>
              <li
                id={`step-${i + 1}`}
                class="flex scroll-mt-20 items-start gap-4 border-t border-border pt-6 sm:gap-5"
              >
                <span
                  class="flex size-11 flex-none items-center justify-center rounded-full bg-accent font-heading text-lg font-bold text-on-accent"
                  aria-hidden="true"
                >
                  {i + 1}
                </span>
                <div class="flex min-w-0 flex-1 flex-col gap-3">
                  <h3 class="text-xl sm:text-[22px]">
                    <span class="sr-only">Step {i + 1}: </span>
                    {step.title}
                  </h3>
                  <p>{step.body}</p>
                  {step.image && (
                    <Image
                      src={step.image}
                      alt={step.imageAlt ?? ''}
                      widths={[480, 780, 1100]}
                      sizes="(min-width: 840px) 720px, 100vw"
                      class="w-full rounded-md border border-border"
                    />
                  )}
                  {step.tip && (
                    <div class="flex flex-col gap-1 rounded-[10px] bg-surface p-4">
                      <b>Tip</b>
                      <p class="text-[14px]">{step.tip}</p>
                    </div>
                  )}
                </div>
              </li>
              {i + 1 === adAfter && (
                <li class="list-none" aria-hidden="true">
                  <AdSlot size="in-feed" />
                </li>
              )}
            </>
          ))}
        </ol>
      </section>

      {data.troubleshooting.length > 0 && (
        <Faq items={data.troubleshooting} id="troubleshooting" title="If it doesn't work" />
      )}

      {guide && (
        <section
          class="flex flex-wrap items-center justify-between gap-4 rounded-[10px] border border-border p-5"
          aria-label="Related buying guide"
        >
          <div class="flex max-w-[520px] flex-col gap-1">
            <span class="lbl">Time for a new one?</span>
            <b>{guide.title}</b>
          </div>
          <a class="btn" href={guide.url}>
            See the guide
          </a>
        </section>
      )}
    </div>

    <div class="hidden flex-col gap-6 lg:flex">
      <AdSlot size="skyscraper" class="self-center" />
      <nav
        class="flex flex-col gap-3 rounded-[10px] border border-border bg-bg p-5 lg:sticky lg:top-6"
        aria-labelledby="steps-nav"
      >
        <h2 id="steps-nav" class="lbl font-sans">
          Steps
        </h2>
        <ol class="flex flex-col gap-2 text-[14px]">
          {data.steps.map((step, i) => (
            <li>
              <a href={`#step-${i + 1}`} class="text-text">
                {i + 1}. {step.title}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>

    {related.length > 0 && (
      <section class="col-span-full flex flex-col gap-5" aria-labelledby="related-howtos">
        <div class="sec-head">
          <h2 id="related-howtos" class="text-2xl">
            Related how-tos
          </h2>
          {howtoType && (
            <a class="lbl" href={contentTypePath(howtoType)}>
              All how-tos ›
            </a>
          )}
        </div>
        <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,220px),1fr))] gap-6">
          {related.map((item) => (
            <ArticleCard item={item} />
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
