# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).
# Not served as a file. No Content-Security-Policy yet: AdSense and the inline theme script need a
# tuned policy; add one (report-only first) after ads are approved.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000

# Fingerprinted build output never changes under the same name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Preview deployments already get X-Robots-Tag: noindex from Cloudflare.
